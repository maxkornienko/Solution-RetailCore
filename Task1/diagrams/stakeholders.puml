@startmindmap
<style>
mindmapDiagram {
  node {
    BackgroundColor #D9D9D9
    LineColor #D9D9D9
    FontColor #222222
    FontSize 13
    RoundCorner 14
    Padding 10
    MaximumWidth 240
  }
  arrow {
    LineColor #555555
    LineThickness 1.5
  }
  :depth(0) {
    BackgroundColor #7A8B57
    LineColor #7A8B57
    FontColor #FFFFFF
    FontStyle bold
  }
  :depth(1) {
    BackgroundColor #A3B183
    LineColor #A3B183
  }
  .nogoal {
    BackgroundColor #F4F4F4
    LineColor #BBBBBB
    FontColor #888888
  }
}
legend {
  BackgroundColor #F4F4F4
  LineColor #BBBBBB
  FontColor #888888
  FontSize 13
  RoundCorner 14
}
</style>

